# Copy to .env and fill in the keys you plan to use.
# Only the providers you route tasks to in config.yaml need keys.

# Anthropic (Claude) — used when a task in config.yaml has provider: claude
ANTHROPIC_API_KEY=

# Google Gemini — free tier is generous; get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Any OpenAI-compatible endpoint (OpenAI, Groq, Together, OpenRouter, ...)
# used when a task has provider: openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (local) — no key needed; override if not on the default port
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Redirect all user data (database, audio, slides) somewhere else. Leave unset
# for normal use; automated tests set this so they never touch real recordings.
# RECALL_DATA_DIR=
